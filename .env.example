APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# يطابق عنوان تشغيل Laravel (مثلاً php artisan serve → http://127.0.0.1:8000)
APP_URL=http://127.0.0.1:8000

# إذا استخدمت مصادقة الكوكيز مع SPA على منفذ Vite، أضف النطاقات هنا (اختياري؛ المشروع يستخدم Bearer غالباً)
# SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (محلي): أنشئ القاعدة أولاً، مثلاً:
#   CREATE DATABASE lesahtak CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ثم: php artisan migrate --force && php artisan db:seed --force
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lesahtak
DB_USERNAME=root
DB_PASSWORD=

# للتطوير بدون MySQL يمكنك استخدام SQLite بدل الأسطر أعلاه:
# DB_CONNECTION=sqlite
# DB_DATABASE="${PWD}/database/database.sqlite"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Gmail example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your_gmail_app_password
# MAIL_ENCRYPTION=tls

# SMS OTP — Africa's Talking أو مزود JSON عام
# Africa's Talking: URL يحوي africas talking.com ⇒ يُرسل كـ form-urlencoded مع header apiKey
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
# اسم التطبيق في Africa'sTalking (sandbox يستخدم اسم المستخدم sandbox + رابط sandbox)
AT_USERNAME=sandbox
# SMS_PROVIDER_DRIVER=auto — auto | africastalking | generic_json

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Qwen via OpenRouter
QWEN_API_KEY=your_openrouter_api_key
QWEN_MODEL=qwen/qwen-2.5-72b-instruct
LLM_PROVIDER=openrouter

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemma-3-12b-it,gemini-2.5-flash
GEMINI_RETRY_ATTEMPTS=1
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768

# Vector DB — Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=rag
PINECONE_HOST=https://your-index.svc.region.pinecone.io

RAG_NAMESPACES=medical,drugs,guidelines
RAG_ENABLED=false
RAG_TOP_K=10
RAG_FINAL_TOP_K=5
RAG_MIN_SCORE=0.65
RAG_HISTORY_TURNS=6
RAG_MESSAGE_MAX_LENGTH=4000


# --- أمان الإنتاج (مراجعة عند النشر) ---
# - غيّر كلمات المرور الافتراضية لحسابات الـ seed ولا ترفع ملف .env الحقيقي.
# - مسارات API/auth تستخدم throttle في routes/api.php (حدود محاولات التسجيل/الدخول).
# - فعّل APP_DEBUG=false واستخدم HTTPS وCORS صارم في الإنتاج.
